{
  "name": "zeropack",
  "version": "1.0.0",
  "description": "Zero-dependency JavaScript bundler, minifier, and HMR dev server built exclusively with Node.js built-ins.",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "zeropack": "./zeropack.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node src/cli.js --serve",
    "build": "node src/cli.js --minify",
    "build-standalone": "node src/build-tools.js",
    "verify": "node src/build-tools.js --verify",
    "bench": "node scripts/bench.js",
    "test": "node --test \"test/*.test.js\" test/test-server.js",
    "test:realworld": "node scripts/realworld.js",
    "check": "node --test \"test/*.test.js\" test/test-server.js && node scripts/realworld.js"
  },
  "keywords": [
    "bundler",
    "zero-dependency",
    "dev-server",
    "hmr",
    "minifier",
    "node-native"
  ],
  "author": "ZeroPack Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {}
}
